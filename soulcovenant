def execute_tool(name, input_data):
    """Execute a tool and return (success: bool, result: str)."""
    try:
        if name == "bash":
            return _tool_bash(input_data["command"])
        elif name == "read_file":
            return _tool_read_file(input_data["path"])
        elif name == "write_file":
            return _tool_write_file(input_data["path"], input_data["content"])
        elif name == "edit_file":
            return _tool_edit_file(
                input_data["path"], input_data["old_string"], input_data["new_string"]
            )
        else:
            return False, f"Unknown tool: {name}"
    except Exception as e:
        return False, f"Error: {e}"


def _tool_bash(command):
    try:
        result = subprocess.run(
            command, shell=True, capture_output=True, text=True, timeout=120,
        )
        output = ""
        if result.stdout:
            output += result.stdout
        if result.stderr:
            if output:
                output += "\n"
            output += result.stderr
        if not output:
            output = "(no output)"
        if result.returncode != 0:
            output += f"\n[exit code: {result.returncode}]"
        return result.returncode == 0, output
    except subprocess.TimeoutExpired:
        return False, "Command timed out after 120 seconds"


def _tool_read_file(path):
    p = Path(path).expanduser()
    if not p.exists():
        return False, f"File not found: {path}"
    try:
        return True, p.read_text()
    except Exception as e:
        return False, f"Error reading file: {e}"


def _tool_write_file(path, content):
    p = Path(path).expanduser()
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content)
        return True, f"Wrote {len(content)} bytes to {path}"
    except Exception as e:
        return False, f"Error writing file: {e}"


def _tool_edit_file(path, old_string, new_string):
    p = Path(path).expanduser()
    if not p.exists():
        return False, f"File not found: {path}"
    try:
        content = p.read_text()
        count = content.count(old_string)
        if count == 0:
            return False, "old_string not found in file"
        if count > 1:
            return False, f"old_string found {count} times — must be unique. Provide more context."
        new_content = content.replace(old_string, new_string, 1)
        p.write_text(new_content)
        return True, f"Edited {path} (replaced 1 occurrence)"
    except Exception as e:
        return False, f"Error editing file: {e}"


def display_tool_call(name, inp):
    """Show tool invocation in terminal."""
    if name == "bash":
        cmd_display = inp.get("command", "")
        if len(cmd_display) > 80:
            cmd_display = cmd_display[:77] + "..."
        console.print(f"[yellow]⚒ bash:[/yellow] {cmd_display}")
    elif name == "read_file":
        console.print(f"[yellow]⚒ read_file:[/yellow] {inp.get('path', '')}")
    elif name == "write_file":
        console.print(f"[yellow]⚒ write_file:[/yellow] {inp.get('path', '')}")
    elif name == "edit_file":
        console.print(f"[yellow]⚒ edit_file:[/yellow] {inp.get('path', '')}")


def display_tool_result(name, success, result):
    """Show tool result in terminal."""
    status = "[green]✓[/green]" if success else "[red]✗[/red]"
    if name == "bash":
        lines = result.strip().split("\n")
        if len(lines) <= 5:
            for line in lines:
                console.print(f"  {status} {line}")
        else:
            for line in lines[:3]:
                console.print(f"  {status} {line}")
            console.print(f"  [dim]... ({len(lines) - 3} more lines)[/dim]")
    else:
        preview = result[:100] + ("..." if len(result) > 100 else "")
        console.print(f"  {status} {preview}")


