class SoulCovenant:
    def __init__(self, cfg, scroll=None):
        self.cfg = cfg
        self.model = cfg.get("model", DEFAULT_MODEL)
        self.max_tokens = cfg.get("max_tokens", MAX_TOKENS)
        self.api_key = cfg.get("api_key", "")
        self.scroll = scroll or Scroll()
        self.messages = list(self.scroll.messages)
        self.system_prompt = build_system_prompt()
        self._interrupted = False

        # Pre-build clients
        self._anthropic_clients = {}
        self._openai_clients = {}

    def _get_anthropic_client(self, base_url):
        if base_url not in self._anthropic_clients:
            kwargs = {}
            if self.api_key:
                kwargs["api_key"] = self.api_key
            if base_url:
                kwargs["base_url"] = base_url
            self._anthropic_clients[base_url] = anthropic.Anthropic(**kwargs)
        return self._anthropic_clients[base_url]

    def _get_openai_client(self, base_url):
        if base_url not in self._openai_clients:
            self._openai_clients[base_url] = openai.OpenAI(
                api_key=self.api_key or "dummy",
                base_url=base_url,
            )
        return self._openai_clients[base_url]

    def set_model(self, model):
        model = resolve_model(model)
        self.model = model
        provider = get_provider(model)
        models_catalog = self.cfg.get("models", {})
        if model in models_catalog:
            cat = models_catalog[model]
            self.max_tokens = cat.get("max_tokens", MAX_TOKENS)
            console.print(f"[cyan]Model → {cat.get('name', model)} ({model})[/cyan]")
            console.print(f"[dim]  provider: {provider['type']} / context: {cat.get('context_window', '?')} / max_tokens: {self.max_tokens}[/dim]")
        else:
            console.print(f"[cyan]Model → {model}[/cyan]")
            console.print(f"[dim]  provider: {provider['type']}[/dim]")

    def stream_response(self):
        """Send messages to API and stream back. Handles tool loop."""
        while True:
            self._interrupted = False
            provider = get_provider(self.model)
            provider_type = provider["type"]
            base_url = provider["base_url"]

            # Also allow cfg-level base_url override for claude
            if provider_type == "anthropic" and self.cfg.get("base_url"):
                base_url = self.cfg["base_url"]

            try:
                if provider_type == "anthropic":
                    client = self._get_anthropic_client(base_url)
                    text, tool_uses, in_tok, out_tok, has_tools = stream_anthropic(
                        client, self.model, self.max_tokens, self.system_prompt,
                        self.messages, lambda: self._interrupted,
                    )
                else:  # openai
                    client = self._get_openai_client(base_url)
                    text, tool_uses, in_tok, out_tok, has_tools = stream_openai(
                        client, self.model, self.max_tokens, self.system_prompt,
                        self.messages, lambda: self._interrupted,
                    )

            except KeyboardInterrupt:
                self._interrupted = True
                console.print("\n[yellow]⚡ Interrupted[/yellow]")
                return
            except (anthropic.APIError, openai.APIError) as e:
                console.print(f"\n[red]API Error: {e}[/red]")
                return
            except Exception as e:
                console.print(f"\n[red]Error: {e}[/red]")
                return

            # Build and save assistant message (always in canonical anthropic format)
            assistant_msg = build_anthropic_assistant_msg(text, tool_uses)
            if assistant_msg["content"]:
                self.messages.append(assistant_msg)
                self.scroll.append(assistant_msg)

            # Show token usage
            if in_tok or out_tok:
                console.print(f"[dim]tokens: {in_tok} in / {out_tok} out[/dim]")

            # If no tool calls or interrupted, done
            if not has_tools or self._interrupted:
                return

            # Execute tools
            results = []
            for tu in tool_uses:
                name = tu["name"]
                inp = tu["input"]

                display_tool_call(name, inp)
                success, result = execute_tool(name, inp)

                if len(result) > 50000:
                    result = result[:50000] + "\n... (truncated)"

                display_tool_result(name, success, result)

                results.append({"id": tu["id"], "name": name, "output": result, "is_error": not success})

            # Add tool results (canonical anthropic format)
            tool_msg = build_anthropic_tool_results(results)
            self.messages.append(tool_msg)
            self.scroll.append(tool_msg)

            # Continue loop — model will process tool results


