class Scroll:
    """JSONL session persistence."""

    def __init__(self, path=None):
        if path:
            self.path = Path(path)
        else:
            ts = time.strftime("%Y%m%d_%H%M%S")
            self.path = SCROLLS_DIR / f"{ts}.jsonl"
        self.messages = []
        if self.path.exists():
            self._load()

    def _load(self):
        self.messages = []
        try:
            with open(self.path) as f:
                for line in f:
                    line = line.strip()
                    if line:
                        self.messages.append(json.loads(line))
        except Exception as e:
            console.print(f"[yellow]Warning: could not load scroll: {e}[/yellow]")

    def append(self, message):
        self.messages.append(message)
        with open(self.path, "a") as f:
            f.write(json.dumps(message, ensure_ascii=False) + "\n")

    @staticmethod
    def latest():
        scrolls = sorted(SCROLLS_DIR.glob("*.jsonl"))
        return scrolls[-1] if scrolls else None


# ─── Anthropic Streaming Backend ──────────────────────────────────────────────

def stream_anthropic(client, model, max_tokens, system_prompt, messages, interrupted_fn):
    """Stream via anthropic SDK. Returns (text, tool_uses, input_tokens, output_tokens)."""
    tool_uses = []
    input_tokens = 0
    output_tokens = 0
    stop_reason = None

    with client.messages.stream(
        model=model,
        max_tokens=max_tokens,
        system=system_prompt,
        messages=messages,
        tools=TOOL_DEFINITIONS_ANTHROPIC,
    ) as stream:
        current_text = ""
        live = Live(Markdown(""), console=console, refresh_per_second=8, vertical_overflow="visible")
        live.start()
        try:
            for event in stream:
                if interrupted_fn():
                    break

                if event.type == "content_block_start":
                    if event.content_block.type == "tool_use":
                        tool_uses.append({
                            "id": event.content_block.id,
                            "name": event.content_block.name,
                            "input": {},
                            "_input_json": "",
                        })

                elif event.type == "content_block_delta":
                    if event.delta.type == "text_delta":
                        current_text += event.delta.text
                        live.update(Markdown(current_text))
                    elif event.delta.type == "input_json_delta":
                        if tool_uses:
                            tool_uses[-1]["_input_json"] += event.delta.partial_json

                elif event.type == "message_delta":
                    stop_reason = event.delta.stop_reason
                    if hasattr(event, "usage") and event.usage:
                        output_tokens = getattr(event.usage, "output_tokens", 0)

                elif event.type == "message_start":
                    if hasattr(event.message, "usage") and event.message.usage:
                        input_tokens = event.message.usage.input_tokens
        finally:
            live.stop()

    # Parse tool input JSON
    for tu in tool_uses:
        raw = tu.pop("_input_json", "")
        if raw:
            try:
                tu["input"] = json.loads(raw)
            except json.JSONDecodeError:
                tu["input"] = {}

    has_tool_calls = stop_reason == "tool_use" and len(tool_uses) > 0
    return current_text, tool_uses, input_tokens, output_tokens, has_tool_calls


def build_anthropic_assistant_msg(text, tool_uses):
    """Build anthropic-format assistant message."""
    content = []
    if text:
        content.append({"type": "text", "text": text})
    for tu in tool_uses:
        content.append({"type": "tool_use", "id": tu["id"], "name": tu["name"], "input": tu["input"]})
    return {"role": "assistant", "content": content}


def build_anthropic_tool_results(results):
    """Build anthropic-format tool results message."""
    return {"role": "user", "content": [
        {"type": "tool_result", "tool_use_id": r["id"], "content": r["output"], "is_error": r["is_error"]}
        for r in results
    ]}


# ─── OpenAI Streaming Backend ────────────────────────────────────────────────

def stream_openai(client, model, max_tokens, system_prompt, messages, interrupted_fn):
    """Stream via openai SDK. Returns (text, tool_uses, input_tokens, output_tokens, has_tool_calls)."""
    # Convert anthropic-format messages to openai format
    oai_messages = _to_openai_messages(system_prompt, messages)

    tool_uses = []
    input_tokens = 0
    output_tokens = 0

    response = client.chat.completions.create(
        model=model,
        max_tokens=max_tokens,
        messages=oai_messages,
        tools=TOOL_DEFINITIONS_OPENAI,
        stream=True,
    )

    current_text = ""
    # Track tool calls by index
    tc_map = {}  # index → {id, name, arguments_parts}

    live = Live(Markdown(""), console=console, refresh_per_second=8, vertical_overflow="visible")
    live.start()
    try:
        for chunk in response:
            if interrupted_fn():
                break

            if hasattr(chunk, "usage") and chunk.usage:
                input_tokens = getattr(chunk.usage, "prompt_tokens", 0)
                output_tokens = getattr(chunk.usage, "completion_tokens", 0)

            if not chunk.choices:
                continue

            delta = chunk.choices[0].delta

            # Text content
            if delta and delta.content:
                current_text += delta.content
                live.update(Markdown(current_text))

            # Tool calls
            if delta and delta.tool_calls:
                for tc in delta.tool_calls:
                    idx = tc.index
                    if idx not in tc_map:
                        tc_map[idx] = {"id": tc.id or "", "name": "", "arguments": ""}
                    if tc.id:
                        tc_map[idx]["id"] = tc.id
                    if tc.function:
                        if tc.function.name:
                            tc_map[idx]["name"] = tc.function.name
                        if tc.function.arguments:
                            tc_map[idx]["arguments"] += tc.function.arguments
    finally:
        live.stop()

    # Parse tool calls
    for idx in sorted(tc_map.keys()):
        tc = tc_map[idx]
        try:
            inp = json.loads(tc["arguments"]) if tc["arguments"] else {}
        except json.JSONDecodeError:
            inp = {}
        tool_uses.append({"id": tc["id"], "name": tc["name"], "input": inp})

    has_tool_calls = len(tool_uses) > 0
    return current_text, tool_uses, input_tokens, output_tokens, has_tool_calls


def _to_openai_messages(system_prompt, messages):
    """Convert anthropic-format messages to openai chat format."""
    oai = [{"role": "system", "content": system_prompt}]

    for msg in messages:
        role = msg["role"]
        content = msg["content"]

        if role == "user":
            if isinstance(content, str):
                oai.append({"role": "user", "content": content})
            elif isinstance(content, list):
                # Could be tool_results or mixed content
                tool_results = [c for c in content if c.get("type") == "tool_result"]
                if tool_results:
                    for tr in tool_results:
                        oai.append({
                            "role": "tool",
                            "tool_call_id": tr.get("tool_use_id", ""),
                            "content": tr.get("content", ""),
                        })
                else:
                    # Extract text
                    texts = [c.get("text", "") for c in content if c.get("type") == "text"]
                    oai.append({"role": "user", "content": "\n".join(texts)})

        elif role == "assistant":
            if isinstance(content, str):
                oai.append({"role": "assistant", "content": content})
            elif isinstance(content, list):
                text_parts = []
                tool_calls = []
                for c in content:
                    if c.get("type") == "text":
                        text_parts.append(c["text"])
                    elif c.get("type") == "tool_use":
                        tool_calls.append({
                            "id": c["id"],
                            "type": "function",
                            "function": {
                                "name": c["name"],
                                "arguments": json.dumps(c["input"]),
                            },
                        })
                msg_dict = {"role": "assistant"}
                if text_parts:
                    msg_dict["content"] = "\n".join(text_parts)
                else:
                    msg_dict["content"] = None
                if tool_calls:
                    msg_dict["tool_calls"] = tool_calls
                oai.append(msg_dict)

    return oai


def build_openai_assistant_msg(text, tool_uses):
    """Build anthropic-format assistant message (internal canonical format) from openai response."""
    content = []
    if text:
        content.append({"type": "text", "text": text})
    for tu in tool_uses:
        content.append({"type": "tool_use", "id": tu["id"], "name": tu["name"], "input": tu["input"]})
    return {"role": "assistant", "content": content}


