def load_soul():
    """Read all .md files from soul/ directory."""
    parts = []
    for md in sorted(SOUL_DIR.glob("*.md")):
        try:
            content = md.read_text().strip()
            if content:
                parts.append(f"## {md.stem}\n\n{content}")
        except Exception:
            pass
    return "\n\n---\n\n".join(parts)


def build_system_prompt():
    """Build system prompt from genesis.md + soul memories."""
    sections = []

    if GENESIS_FILE.exists():
        try:
            genesis = GENESIS_FILE.read_text().strip()
            if genesis:
                sections.append(genesis)
        except Exception:
            pass

    soul = load_soul()
    if soul:
        sections.append(f"# Soul Memories\n\n{soul}")

    if not sections:
        sections.append(
            "You are a powerful AI coding assistant. "
            "You have access to tools for running bash commands, reading files, writing files, and editing files. "
            "Use them proactively to help the user. Be concise and direct."
        )

    return "\n\n---\n\n".join(sections)


