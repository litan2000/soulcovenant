def resolve_model(name):
    """Resolve model alias or return as-is."""
    return MODEL_ALIASES.get(name.lower(), name)


def get_provider(model):
    """Determine provider config for a model ID."""
    for prefix, cfg in PROVIDERS.items():
        if model.startswith(prefix):
            return cfg
    # Default to anthropic
    return PROVIDERS["claude"]


def load_config():
    """Load config: env vars > covenant.json > defaults."""
    cfg = {"model": DEFAULT_MODEL, "max_tokens": MAX_TOKENS}
    if COVENANT_CFG.exists():
        try:
            with open(COVENANT_CFG) as f:
                file_cfg = json.load(f)
            cfg.update(file_cfg)
        except Exception:
            pass

    # Env overrides
    if os.environ.get("ANTHROPIC_AUTH_TOKEN"):
        cfg["api_key"] = os.environ["ANTHROPIC_AUTH_TOKEN"]
    if os.environ.get("ANTHROPIC_API_KEY"):
        cfg["api_key"] = os.environ["ANTHROPIC_API_KEY"]
    if os.environ.get("ANTHROPIC_BASE_URL"):
        cfg["base_url"] = os.environ["ANTHROPIC_BASE_URL"]
    return cfg


REGISTRY_URL = "https://raw.githubusercontent.com/DaneelOlivaw1/openclaw-aicodewith-auth/main/src/models/registry.ts"


def sync_models():
    """Fetch latest model list from aicodewith plugin repo and update covenant.json."""
    import re
    import urllib.request

    console.print("[cyan]Syncing models from aicodewith plugin repo...[/cyan]")
    try:
        req = urllib.request.Request(REGISTRY_URL, headers={"User-Agent": "SoulCovenant"})
        with urllib.request.urlopen(req, timeout=15) as resp:
            src = resp.read().decode()
    except Exception as e:
        console.print(f"[red]Failed to fetch registry: {e}[/red]")
        return False

    # Parse model blocks — each block is "  { ... }" in the MODELS array
    new_models = {}
    for block in re.findall(r'  \{(.*?)\n  \}', src, re.DOTALL):
        if "deprecated: true" in block:
            continue
        m_id = re.search(r'id:\s*"([^"]+)"', block)
        m_name = re.search(r'(?<!\w)name:\s*"([^"]+)"', block)
        m_family = re.search(r'family:\s*"([^"]+)"', block)
        m_ctx = re.search(r'contextWindow:\s*(\d+)', block)
        m_max = re.search(r'maxTokens:\s*(\d+)', block)
        if not all([m_id, m_name, m_family, m_ctx, m_max]):
            continue
        new_models[m_id.group(1)] = {
            "name": m_name.group(1),
            "family": m_family.group(1),
            "context_window": int(m_ctx.group(1)),
            "max_tokens": int(m_max.group(1)),
        }

    if not new_models:
        console.print("[red]No models found in registry.[/red]")
        return False

    # Load existing covenant.json, update models only
    cfg = {}
    if COVENANT_CFG.exists():
        try:
            with open(COVENANT_CFG) as f:
                cfg = json.load(f)
        except Exception:
            pass

    old_models = cfg.get("models", {})
    cfg["models"] = new_models

    with open(COVENANT_CFG, "w") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write("\n")

    # Diff
    old_ids = set(old_models.keys())
    new_ids = set(new_models.keys())
    added = new_ids - old_ids
    removed = old_ids - new_ids

    console.print(f"[green]✓ Synced {len(new_models)} active models[/green]")
    for mid, info in sorted(new_models.items()):
        tag = " [green](new!)[/green]" if mid in added else ""
        console.print(f"  [dim]{mid}[/dim] — {info['name']} [{info['family']}]{tag}")
    for mid in sorted(removed):
        console.print(f"  [dim]{mid}[/dim] — [red](removed)[/red]")

    return True


