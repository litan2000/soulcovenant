BANNER = r"""[bold magenta]
  ╔═══════════════════════════════════════╗
  ║         S O U L C O V E N A N T      ║
  ╚═══════════════════════════════════════╝[/bold magenta]"""


def print_banner(model):
    provider = get_provider(model)
    console.print(BANNER)
    console.print(f"  [dim]model: {model} ({provider['type']})[/dim]")
    console.print(f"  [dim]type /help for commands[/dim]\n")


def main():
    import argparse

    parser = argparse.ArgumentParser(description="SoulCovenant — lightweight multi-model CLI")
    parser.add_argument("--model", "-m", help="Model to use (name or alias)")
    parser.add_argument("--awaken", "-a", action="store_true", help="Resume the last session")
    parser.add_argument("--scroll", "-s", help="Resume a specific scroll file")
    args = parser.parse_args()

    cfg = load_config()
    if args.model:
        cfg["model"] = resolve_model(args.model)

    # Session setup
    scroll = None
    if args.scroll:
        scroll = Scroll(args.scroll)
        console.print(f"[cyan]Awakened scroll: {args.scroll} ({len(scroll.messages)} messages)[/cyan]")
    elif args.awaken:
        latest = Scroll.latest()
        if latest:
            scroll = Scroll(latest)
            console.print(f"[cyan]Awakened latest scroll: {latest.name} ({len(scroll.messages)} messages)[/cyan]")
        else:
            console.print("[yellow]No scrolls found, starting fresh.[/yellow]")

    cov = SoulCovenant(cfg, scroll)
    print_banner(cov.model)

    def sigint_handler(sig, frame):
        cov._interrupted = True

    signal.signal(signal.SIGINT, sigint_handler)

    # prompt_toolkit: Enter for newline, Alt+Enter (Esc then Enter) to send
    kb = KeyBindings()

    @kb.add("escape", "enter")  # Alt+Enter → send
    def _(event):
        buf = event.current_buffer
        if buf.text.strip():
            buf.validate_and_handle()

    session = PromptSession(key_bindings=kb, multiline=True)

    while True:
        try:
            console.print()
            user_input = session.prompt("you> ").strip()
        except (EOFError, KeyboardInterrupt):
            console.print("\n[magenta]Ascending...[/magenta]")
            break

        if not user_input:
            continue

        # Commands
        if user_input.startswith("/"):
            cmd = user_input.lower().split()
            cmd_name = cmd[0]

            if cmd_name in ("/ascend", "/quit", "/exit"):
                console.print("[magenta]Ascending...[/magenta]")
                break

            elif cmd_name in ("/rebirth", "/new"):
                cov.scroll = Scroll()
                cov.messages = []
                cov.system_prompt = build_system_prompt()
                console.print("[cyan]Reborn. New scroll started.[/cyan]")
                continue

            elif cmd_name == "/model":
                if len(cmd) > 1:
                    cov.set_model(cmd[1])
                else:
                    console.print(f"[cyan]Current model: {cov.model}[/cyan]")
                    models_catalog = cov.cfg.get("models", {})
                    if models_catalog:
                        console.print("[bold]Available models:[/bold]")
                        for mid, info in models_catalog.items():
                            p = get_provider(mid)
                            marker = " [green]◄[/green]" if mid == cov.model else ""
                            console.print(
                                f"  [dim]{mid}[/dim] — {info.get('name', '?')} "
                                f"[{p['type']}] "
                                f"(ctx {info.get('context_window', '?')}, max {info.get('max_tokens', '?')})"
                                f"{marker}"
                            )
                    if MODEL_ALIASES:
                        console.print("[bold]Aliases:[/bold]")
                        seen = {}
                        for alias, mid in MODEL_ALIASES.items():
                            seen.setdefault(mid, []).append(alias)
                        for mid, aliases in seen.items():
                            console.print(f"  [dim]{', '.join(aliases)}[/dim] → {mid}")
                continue

            elif cmd_name == "/scrolls":
                scrolls = sorted(SCROLLS_DIR.glob("*.jsonl"))
                if not scrolls:
                    console.print("[dim]No scrolls yet.[/dim]")
                else:
                    for s in scrolls[-10:]:
                        count = sum(1 for _ in open(s))
                        console.print(f"  [dim]{s.name}[/dim] ({count} messages)")
                continue

            elif cmd_name == "/soul":
                soul_files = sorted(SOUL_DIR.glob("*.md"))
                if not soul_files:
                    console.print("[dim]No soul memories yet.[/dim]")
                else:
                    for sf in soul_files:
                        size = sf.stat().st_size
                        console.print(f"  [dim]{sf.name}[/dim] ({size} bytes)")
                continue

            elif cmd_name == "/sync":
                if sync_models():
                    # Reload config to pick up new models
                    cov.cfg = load_config()
                continue

            elif cmd_name == "/help":
                console.print("[bold]Commands:[/bold]")
                console.print("  /rebirth, /new   — Start a new session")
                console.print("  /ascend, /quit   — Exit")
                console.print("  /model [name]    — Show or switch model")
                console.print("  /sync            — Sync models from aicodewith")
                console.print("  /scrolls         — List saved sessions")
                console.print("  /soul            — List soul memories")
                console.print("  /help            — Show this help")
                console.print()
                console.print("[bold]Multi-line input:[/bold]")
                console.print("  Enter for newline, Alt+Enter (or Esc then Enter) to send")
                console.print()
                console.print("[bold]Model aliases:[/bold]")
                console.print("  opus, sonnet, haiku — Claude models")
                console.print("  codex, gpt5.2       — GPT models")
                console.print("  gemini              — Gemini models")
                continue

            else:
                console.print(f"[yellow]Unknown command: {cmd_name}[/yellow]")
                continue

        # Normal message
        user_msg = {"role": "user", "content": user_input}
        cov.messages.append(user_msg)
        cov.scroll.append(user_msg)

        console.print()
        cov.stream_response()


if __name__ == "__main__":
    main()
